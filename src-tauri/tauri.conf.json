{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTimeFlow",
  "version": "0.1.5",
  "identifier": "com.youtimeflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouTimeFlow",
        "width": 300,
        "height": 200,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGMDcwRDkwMkREQjlDMDMKUldRRG5Oc3RrQTBIMzBQNG5sV0JWSFA5cktERk5KckJpbmJLbTFPbUZDK3ZNcElVTStoMld0TGwK",
      "endpoints": [
        "https://github.com/bhyuksel/YouTimeFlow/releases/latest/download/latest.json"
      ]
    }
  }
}
