{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTimeFlow",
  "version": "0.1.0",
  "identifier": "com.youtimeflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouTimeFlow",
        "width": 300,
        "height": 200,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "dragDropEnabled": false
      },
      {
        "label": "menu",
        "title": "Menü",
        "url": "/?window=menu",
        "width": 750,
        "height": 600,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
